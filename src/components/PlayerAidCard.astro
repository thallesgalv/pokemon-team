---
import { cardSizeVars } from "../lib/cards";
import type { PlayerAidView } from "../lib/playerAid";
import "../styles/card.css";

interface Props {
  card: PlayerAidView;
  bleed?: boolean;
}

const { card, bleed = false } = Astro.props;
---

<article class:list={["card", "player-aid", `player-aid-${card.color}`]} style={cardSizeVars(bleed)} data-card-id={card.id}>
  <div class="player-aid-frame">
    <header
      class:list={[
        "player-aid-heading",
        { "player-aid-heading-right": card.arrow === "right", "player-aid-heading-long": card.title.length > 12 },
      ]}
    >
      <div class="card-points player-aid-arrow">
        <svg viewBox="0 0 64 80" width="44" height="55" aria-hidden="true">
          <path d="M32 6 L58 38 H42 V74 H22 V38 H6 Z" fill="#344358" />
        </svg>
      </div>
      <h2 class="player-aid-title">{card.title}</h2>
    </header>

    <div class:list={["player-aid-body", { "player-aid-dense": card.steps.length > 4 }]}>
      {
        card.steps.map((step) => (
          <section class="player-aid-step">
            <h3>{step.title}</h3>
            <p set:html={step.text} />
          </section>
        ))
      }
    </div>
  </div>
</article>

<style>
  .player-aid {
    display: flex;
  }

  /* Cores dos raios, as mesmas das cartas de preço */
  .player-aid-verde {
    --ray-light: #3d9a6b;
    --ray-dark: #34895e;
  }

  .player-aid-azul {
    --ray-light: #3d7fc4;
    --ray-dark: #3470b0;
  }

  /* Moldura colorida com raios, painel creme por dentro, como a carta de referência do Flip Toons */
  .player-aid-frame {
    box-sizing: border-box;
    flex: 1;
    min-width: 0;
    margin: 40px;
    padding: 0 22px 22px;
    display: flex;
    flex-direction: column;
    border-radius: 32px;
    background: repeating-conic-gradient(from 0deg at 50% 8%, var(--ray-light) 0deg 7deg, var(--ray-dark) 7deg 14deg);
  }

  .player-aid-heading {
    flex: none;
    height: 140px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
  }

  .player-aid-heading-right {
    flex-direction: row-reverse;
  }

  .player-aid-arrow {
    flex: none;
    width: 92px;
    height: 92px;
    border-width: 7px;
    box-shadow:
      inset 0 0 0 4px #d8d999,
      inset 0 0 0 7px #344358,
      0 6px 0 rgb(0 0 0 / 0.18);
  }

  /* Mesmo estilo do nome nas cartas Pokémon: branco com contorno */
  .player-aid-title {
    margin: 0;
    font-family: "Arial Black", sans-serif;
    font-weight: 900;
    font-size: 64px;
    line-height: 1;
    white-space: nowrap;
    color: #fff;
    -webkit-text-stroke: 12px #344358;
    paint-order: stroke fill;
  }

  /* Títulos longos (ex.: Palavras-chave) diminuem para a moeda não encostar na moldura */
  .player-aid-heading-long .player-aid-title {
    font-size: 52px;
    -webkit-text-stroke: 10px #344358;
  }

  .player-aid-body {
    flex: 1;
    min-height: 0;
    box-sizing: border-box;
    padding: 20px 28px;
    display: flex;
    flex-direction: column;
    justify-content: space-evenly;
    border-radius: 20px;
    background: #f7ece6;
    color: #344358;
  }

  /* Título da seção em faixa azul-marinho, como a passiva das cartas Pokémon */
  .player-aid-step h3 {
    display: inline-block;
    margin: 0;
    padding: 6px 20px;
    border-radius: 10px;
    background: #344358;
    color: #fff;
    font-family: "Arial Black", sans-serif;
    font-weight: 900;
    font-size: 36px;
    line-height: 1.1;
  }

  .player-aid-step p {
    margin: 10px 0 0;
    font-size: 29px;
    line-height: 1.25;
  }

  .player-aid-step p :global(strong) {
    font-weight: 900;
  }

  .player-aid-step p :global(em) {
    font-size: 0.85em;
  }

  /* Palavras-chave: título e texto mais compactos para caberem as seis seções */
  .player-aid-dense .player-aid-step h3 {
    font-size: 30px;
    padding: 4px 16px;
  }

  .player-aid-dense .player-aid-step p {
    margin-top: 6px;
    font-size: 26px;
  }
</style>
