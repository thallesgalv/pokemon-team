---
import { cardSizeVars } from "../lib/cards";
import { scoreRows, type ScoreCardView } from "../lib/scoreCard";
import "../styles/card.css";

interface Props {
  card: ScoreCardView;
  bleed?: boolean;
}

const { card, bleed = false } = Astro.props;
const rows = scoreRows(card.side);
// 30 aciona a Revelação Final e ganha destaque, como no placar do Flip Toons
const isTrigger = (value: number) => value === 30;
---

<article class="card score-card" style={cardSizeVars(bleed)} data-card-id={card.id}>
  <div class="score-table">
    {
      rows.map((row) =>
        row.map((cell) => (
          // Fundo na cor da faixa e caixa clara com a insígnia e a moeda de pontos
          <div class="score-cell" style={`--tier: ${cell.color}`}>
            <div class:list={["score-box", { "score-box-trigger": isTrigger(cell.value) }]}>
              <img src={cell.badge} alt="" width="56" height="56" />
              <div class:list={["card-points", "score-coin", { "score-coin-long": cell.value > 9 }]}>{cell.value}</div>
            </div>
          </div>
        )),
      )
    }
  </div>
</article>

<style>
  .score-card {
    display: flex;
  }

  .score-table {
    box-sizing: border-box;
    flex: 1;
    margin: 40px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: repeat(10, 1fr);
    grid-auto-flow: row;
    border: 8px solid #344358;
    border-radius: 40px;
    overflow: hidden;
    background: #344358;
    gap: 0 8px;
  }

  .score-cell {
    display: flex;
    padding: 7px 14px;
    background: var(--tier);
  }

  .score-box {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 28px;
    border-radius: 14px;
    background: #f7ece6;
  }

  .score-box-trigger {
    background: #f2b33d;
    box-shadow: inset 0 0 0 5px #344358;
  }

  .score-box img {
    width: 56px;
    height: 56px;
    object-fit: contain;
  }

  /* Mesma moeda dos pontos das cartas Pokémon, em escala menor */
  .score-coin {
    width: 76px;
    height: 76px;
    border-width: 5px;
    font-size: 48px;
    box-shadow:
      inset 0 0 0 3px #d8d999,
      inset 0 0 0 5px #344358;
  }

  .score-coin-long {
    font-size: 36px;
    letter-spacing: -1px;
  }
</style>
